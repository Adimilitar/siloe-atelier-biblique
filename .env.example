# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional server-side key when enabling OpenAI provider in the relay.
OPENAI_API_KEY=""

# VITE_AI_RELAY_URL: Optional external relay URL (e.g. Cloudflare Worker) for GitHub Pages static deployment.
# Leave empty in full-stack Express / AI Studio mode to use local /api/ai/* routes.
VITE_AI_RELAY_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
